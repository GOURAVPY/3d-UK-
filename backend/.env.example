# Copy to .env and fill in. .env is git-ignored: never commit a real key.

# Free key from https://api-portal.tfl.gov.uk (sign up, then Products > subscribe, then Profile > keys).
# Without it TfL still answers, but rate-limits you and some lines go missing.
TFL_APP_KEY=

# Port for the API and WebSocket. Render and similar hosts set this for you.
PORT=3001
